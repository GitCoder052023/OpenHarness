# ==============================================================================
# OpenHarness Configuration
# ==============================================================================

# REST API Server Configuration
OPENHARNESS_PORT=8080
OPENHARNESS_HOST=0.0.0.0
OPENHARNESS_SAFE_MODE=true

# Developer Harness Settings
HARNESS_TIMEOUT=60.0

# Browser Harness CDP Configuration (Chrome background control & domain skills)
BH_AGENT_WORKSPACE=src/tools/browser-harness/agent-workspace
BH_DOMAIN_SKILLS=1
BH_TAB_MARKER=1

# Firecrawl Web Ingestion & Extraction Engine (Local Docker or cloud)
FIRECRAWL_API_URL=http://localhost:3002
FIRECRAWL_API_KEY=
FIRECRAWL_TIMEOUT=60.0

# LocoAgent Social Media Automation Engine (CDP Browser Profiles)
LOCOAGENT_ENABLED=true
LOCOAGENT_ROOT=
LOCOAGENT_DEFAULT_PLATFORM=threads
LOCOAGENT_TIMEOUT=120.0

# Logging & Diagnostics
OPENHARNESS_LOG_FILE=~/Library/Logs/OpenHarness/harness.jsonl
